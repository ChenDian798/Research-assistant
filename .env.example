OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: use this for OpenAI-compatible providers.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional per-node model overrides.
# INTENT_MODEL=
# RESEARCH_MODEL=
# SYNTHESIS_MODEL=

# Optional for DeepSeek V4. Use "enabled" for deeper reasoning, "disabled" for speed.
# DEEPSEEK_THINKING=disabled

# Optional deployment/runtime settings.
# WEB_HOST=0.0.0.0
# Keep mutable logs, exports, and legacy migration files outside the Git checkout.
# RESEARCH_AGENT_RUNTIME_DIR=/var/lib/research-agent
# RESEARCH_AGENT_CONTACT_EMAIL=admin@example.com
ALLOW_SELF_REGISTRATION=true
SESSION_TTL_SECONDS=28800
# Set false only for local HTTP testing. Keep true behind HTTPS in internal/prod deployments.
SESSION_COOKIE_SECURE=true

# Durable production state. PostgreSQL is the system of record; Redis is only
# Celery's broker/result backend. Set TASK_QUEUE_MODE=thread only for a local,
# single-process demo; never use it in production.
# DATABASE_URL=postgresql://research:change-me@127.0.0.1:5432/research_agent
TASK_QUEUE_MODE=celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_QUEUE=research-jobs
CELERY_TASK_MAX_RETRIES=3
JOB_RETENTION_DAYS=30
UPLOAD_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=30

# Private S3/MinIO object storage. Do not put uploads or exports in the Git
# working tree in production.
# OBJECT_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=research-agent-private
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=change-me

# Upload safety limits. Keep these enforced at both the app and reverse-proxy layers.
MAX_UPLOAD_TOTAL_MB=30
MAX_UPLOAD_FILE_MB=15
MAX_UPLOAD_FILES=4
PDF_UPLOAD_MAX_PAGE_COUNT=300
MAX_UPLOAD_EXTRACTED_TEXT_CHARS=300000
UPLOAD_PARSE_TIMEOUT_SECONDS=30
PDF_PARSER_SANDBOX=enabled
MAX_DOCX_UNZIPPED_MB=20
MAX_DOCX_XML_MB=10
MAX_DOCX_ZIP_ENTRIES=200
MAX_DOCX_COMPRESSION_RATIO=100

# Internal/prod uploads require clamd. `docker compose -f docker-compose.persistence.yml up -d`
# starts a ClamAV service on this host/port.
UPLOAD_VIRUS_SCAN=required
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# PDF extraction page budget. Use a number such as 120 or 200, or "all" for full-document extraction.
# PDF_EXTRACT_PAGE_LIMIT=120
# PDF parser mode: auto keeps the current pypdf/PyMuPDF path and tries OpenDataLoader only when extraction is sparse.
# Install opendataloader-pdf and Java 11+ before using PDF_PARSER=opendataloader.
# PDF_PARSER=auto
# PDF_OPENDATALOADER_MIN_CHARS=2000
# PDF_OPENDATALOADER_MIN_PAGE_RATIO=0.5

# Optional evidence packet optimizer before analyst extraction. Disable for maximum speed.
# LLM_EVIDENCE_REFINEMENT=enabled
# EVIDENCE_REFINEMENT_MODEL=

# Optional academic search integration.
PAPER_SEARCH_ENABLED=false
PAPER_SEARCH_COMMAND=paper-search
PAPER_SEARCH_DEFAULT_SOURCES=arxiv
PAPER_SEARCH_TIMEOUT_SECONDS=45
PAPER_SEARCH_MAX_RESULTS_PER_SOURCE=5
PAPER_SEARCH_MAX_TOTAL=40
# Bound parallel work. Keep this low enough to respect academic API limits.
PAPER_SEARCH_SOURCE_CONCURRENCY=4
PAPER_VERIFY_CONCURRENCY=5
# Fast searches may disable optional model planning entirely.
# PAPER_SEARCH_MODE_INFERENCE=rules
# PAPER_SEARCH_QUERY_REWRITE=rules

# Conservative defaults for model-provider retries.
LLM_MAX_ATTEMPTS=2
LLM_RETRY_MAX_DELAY_SECONDS=3
LLM_REQUEST_TIMEOUT_SECONDS=30

# Optional topic-relevance gate. "rules" is fast and local; "medcpt" uses NCBI MedCPT if transformers/torch are available.
PAPER_RELEVANCE_RERANKER=rules
PAPER_RELEVANCE_MEDCPT_MODEL=ncbi/MedCPT-Cross-Encoder
PAPER_RELEVANCE_MEDCPT_MIN_SCORE=0.35

# Optional provider keys used by paper-search-mcp.
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_MCP_CORE_API_KEY=
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
