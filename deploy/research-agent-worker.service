[Unit]
Description=Research Assistant Celery worker
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/research-agent
ExecStart=/opt/research-agent/.venv/bin/python -m celery -A src.research_agent.web_tasks.celery_app worker --loglevel=INFO --queues=research-jobs --concurrency=2
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s

[Install]
WantedBy=multi-user.target
