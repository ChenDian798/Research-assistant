# Copy to /etc/research-agent/research-agent.env as root:research-agent, mode 0640.
# Use URL-safe random values for passwords used inside DATABASE_URL.

OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

WEB_HOST=127.0.0.1
RESEARCH_AGENT_CONTACT_EMAIL=admin@example.com
ALLOW_SELF_REGISTRATION=false
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true

POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://research:replace-with-a-long-url-safe-password@127.0.0.1:5432/research_agent
TASK_QUEUE_MODE=celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_QUEUE=research-jobs
CELERY_TASK_MAX_RETRIES=3
DATA_RETENTION_DAYS=30
JOB_RETENTION_DAYS=30
UPLOAD_RETENTION_DAYS=14
EXPORT_RETENTION_DAYS=7

MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
OBJECT_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=research-agent-private
AWS_ACCESS_KEY_ID=replace-with-the-same-access-key
AWS_SECRET_ACCESS_KEY=replace-with-the-same-random-secret
AWS_DEFAULT_REGION=us-east-1
# Leave blank for local MinIO unless a MinIO KMS/KES backend is configured.
# For a compatible cloud object store, set AES256 or aws:kms as appropriate.
S3_SERVER_SIDE_ENCRYPTION=
# S3_SSE_KMS_KEY_ID=

MAX_UPLOAD_TOTAL_MB=30
MAX_UPLOAD_FILE_MB=15
MAX_UPLOAD_FILES=4
PDF_UPLOAD_MAX_PAGE_COUNT=300
MAX_UPLOAD_EXTRACTED_TEXT_CHARS=300000
UPLOAD_PARSE_TIMEOUT_SECONDS=30
PDF_PARSER_SANDBOX=enabled
MAX_DOCX_UNZIPPED_MB=20
MAX_DOCX_XML_MB=10
MAX_DOCX_ZIP_ENTRIES=200
MAX_DOCX_COMPRESSION_RATIO=100
UPLOAD_VIRUS_SCAN=required
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

PAPER_SEARCH_MAX_RESULTS_PER_SOURCE=5
PAPER_SEARCH_MAX_RESULTS_PER_SOURCE_CAP=5
PAPER_SEARCH_MAX_TOTAL=40

# Required for Chinese PDF export on Ubuntu (`sudo apt install fonts-wqy-zenhei`).
PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
# PDF_BOLD_FONT_PATH=
